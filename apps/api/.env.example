# Puerto de la API
PORT=3000
# Clave gratuita de https://dashboard.api-football.com (se usa desde HU-002)
API_FOOTBALL_KEY=
# simulated: proyecta la temporada de desarrollo a fechas actuales (HU-005) · real: datos tal cual
CLOCK_MODE=simulated
SIM_ANCHOR=2024-10-24T19:30:00Z
# snapshot: guarda la primera respuesta y la reutiliza siempre (desarrollo) · ttl: refresca por tipo de dato (producción)
CACHE_MODE=snapshot
CACHE_DIR=.cache
# Precarga (npm run seed): peticiones máximas por ejecución y días alrededor de SIM_ANCHOR con fichas completas
SEED_DAILY_BUDGET=90
SEED_WINDOW_DAYS=2
# Protecciones HTTP (TRD §6)
RATE_LIMIT_MAX=120
CORS_ORIGIN=http://localhost:5173
